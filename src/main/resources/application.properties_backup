spring.application.name=board-backend

# ===========================
# DataSource (MariaDB)
# ===========================
spring.datasource.url=jdbc:mariadb://localhost:3306/board_db
spring.datasource.username=root
spring.datasource.password=q16281310!
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

# ===========================
# JPA / Hibernate
# ===========================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect

# ===========================
# File Upload
# ===========================
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=30MB

# ===========================
# JWT
# ===========================
jwt.secret=your-very-long-secret-key-at-least-256-bits-for-hs256-algorithm-replace-this
jwt.expiration=86400000
jwt.refresh-expiration=604800000

# ===========================
# File Storage
# ===========================
file.upload-dir=./uploads

# ===========================
# Logging
# ===========================
logging.level.com.board=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.orm.jdbc.bind=TRACE